{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "umans": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Umans AI",
      "options": {
        "baseURL": "https://api.code.umans.ai/v1",
        "apiKey": "{env:UMANS_API_KEY}"
      },
      "models": {
        "umans-coder": {
          "name": "umans-coder"
        },
        "umans-flash": {
          "name": "umans-flash"
        },
        "umans-kimi-k3": {
          "name": "umans-kimi-k3"
        },
        "umans-glm-5.3": {
          "name": "umans-glm-5.3"
        },
        "umans-glm-5.3-flash": {
          "name": "umans-glm-5.3-flash"
        },
        "umans-deepseek-v4.1-flash": {
          "name": "umans-deepseek-v4.1-flash"
        },
        "umans-deepseek-v4-flash-0731": {
          "name": "umans-deepseek-v4-flash-0731"
        },
        "umans-qwen3.6-35b-a3b": {
          "name": "umans-qwen3.6-35b-a3b"
        },
        "umans-deepseek-v4.1-flash-lab": {
          "name": "umans-deepseek-v4.1-flash-lab"
        },
        "umans-mimo-v2.6-pro-lab": {
          "name": "umans-mimo-v2.6-pro-lab"
        }
      }
    },
    "scw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Scaleway Generative APIs",
      "options": {
        "baseURL": "https://api.scaleway.ai/v1",
        "apiKey": "{env:SCW_SECRET_KEY}"
      },
      "models": {
        "<model-id-a-remplacer>": {
          "name": "Modèle Scaleway (à remplacer)"
        }
      }
    },
    "scw-managed": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Scaleway Managed Inference",
      "options": {
        "baseURL": "{env:SCW_MANAGED_BASE_URL}",
        "apiKey": "{env:SCW_SECRET_KEY}"
      },
      "models": {
        "<model-id-a-remplacer>": {
          "name": "Modèle déployé (à remplacer)"
        }
      }
    }
  }
}
