# Copier en runner/.env. Ce fichier n'est jamais commité.
# Décommenter et renseigner uniquement les variables utilisées.
# Valeurs sans espaces ni guillemets (le fichier est aussi lu par le shell).

# --- Fournisseurs intégrés à OpenCode (exemples) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Fournisseurs déclarés dans runner/opencode.json ---
# umans.ai (modèles : umans/umans-coder, umans/umans-flash, umans/umans-kimi-k2.7, umans/umans-glm-5.2)
# UMANS_API_KEY=
# Scaleway : clé secrète IAM, commune à Generative APIs (scw/...) et Managed Inference (scw-managed/...)
# SCW_SECRET_KEY=
# Scaleway Managed Inference : URL du point de terminaison du déploiement, terminée par /v1
# SCW_MANAGED_BASE_URL=

# --- Consommation ---
# Devise des coûts affichés : libellé seulement, les montants viennent des tarifs
# déclarés pour le modèle (en USD pour les fournisseurs intégrés à OpenCode).
COST_CURRENCY=USD
# Messages d'erreur qui signalent un crédit épuisé (expression régulière). Défaut dans agent-loop.sh.
# CREDIT_ERROR_PATTERNS=insufficient[_ ]quota|credit balance|payment required

# --- Publication des runs ---
# Jeton autorisé à pousser sur le dépôt de contexte (idéalement limité à ce seul dépôt).
# GIT_PUSH_TOKEN=
# Nom d'utilisateur associé au jeton : x-access-token (GitHub), oauth2 (GitLab).
GIT_PUSH_USER=x-access-token
# URL https du dépôt distant. Par défaut : l'origin du dépôt de contexte.
# RUN_REMOTE=https://github.com/<compte>/<depot>.git
