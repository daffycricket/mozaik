{
  "name": "mozaik",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "lint": "biome check . && tsx tooling/check-colors-cli.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/model/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:cov": "vitest run --config vitest.cov.config.ts --coverage",
    "test:e2e": "tsx tooling/ensure-playwright-browsers.ts && playwright test",
    "report": "tsx tooling/report-cli.ts",
    "ac:check": "tsx tooling/ac-check-cli.ts",
    "verify": "tsx tooling/verify-cli.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "simple-git-hooks": {
    "commit-msg": "node_modules/.bin/tsx tooling/commit-msg-cli.ts \"$1\""
  }
}
