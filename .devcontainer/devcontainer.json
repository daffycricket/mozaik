{
  "name": "miro-app agent",
  "build": { "dockerfile": "../runner/Dockerfile", "context": "../runner" },
  "overrideCommand": true,
  "remoteUser": "node",
  "runArgs": ["--shm-size=1g"],
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerEnv": { "OPENCODE_CONFIG": "/runner/opencode/opencode.json", "OPENCODE_CONFIG_DIR": "/runner/opencode", "GUARD_LOG": "/tmp/guard.jsonl" },
  "postCreateCommand": "echo 'Environnement prêt : opencode, pnpm, git, dépendances Playwright.'"
}
